# Used when running the backend directly on Windows (not in Docker). Copy to backend/.env.
ENVIRONMENT=development
# SQLite needs no setup; for PostgreSQL use e.g. postgresql+psycopg://user:password@localhost:5432/infomind
DATABASE_URL=sqlite:///./infomind.db
# Qdrant server, ":memory:" (tests), or "path:./data/qdrant" (embedded, single process, no Docker needed)
QDRANT_URL=path:../data/qdrant
OLLAMA_BASE_URL=http://localhost:11434
# Only when Ollama is behind the authenticating gateway (docs/DEPLOYMENT.md): sent as a Bearer token. Leave empty otherwise.
# OLLAMA_API_KEY=
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# "ollama" (real embeddings) or "hash" (lexical, CPU-only, dev/test only)
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768
JWT_SECRET=change-me-to-a-long-random-string
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=change-me-admin-password
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
