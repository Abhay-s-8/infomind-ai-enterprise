# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
# Only if the password contains @ : / % — then also set the URL with the password percent-encoded (@ -> %40):
# DATABASE_URL=postgresql+psycopg://infomind:<url-encoded-password>@postgres:5432/infomind
# Only if host port 5432 is already in use (e.g. a local PostgreSQL):
# POSTGRES_HOST_PORT=5433
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Development-only administrator (created on startup when both are set). Remove for anything shared.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=change-me-admin-password
# Ollama runs natively on Windows; containers reach it via host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Only when Ollama is behind the authenticating gateway (docs/DEPLOYMENT.md). Leave empty otherwise.
# OLLAMA_API_KEY=
# llama3.2:3b is light but sometimes wrongly refuses answerable questions; llama3.1:8b measured better (docs/EVALUATION.md, ~4.9 GB download, ~4.6 GB VRAM)
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
